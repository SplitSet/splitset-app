# === SplitSet Production Environment ===
# Copy this to .env file after setting up Redis

# === ENVIRONMENT ===
NODE_ENV=production
PORT=5000

# === DATABASE (Production PostgreSQL on Render) ===
DATABASE_URL=postgresql://splitset_production_user:ByJwpQYIascAovCe4DeSIjGFEmpLJ4D4@dpg-d2vkkr8dl3ps7399sc0g-a.oregon-postgres.render.com/splitset_production

# === REDIS (Production - Replace after creating Redis on Render) ===
# Follow RENDER_REDIS_SETUP.md to create Redis instance
# Then replace with your actual Redis URL from Render dashboard
REDIS_URL=redis://red-xxxxxxxxxxxxx:6379
REDIS_HOST=red-xxxxxxxxxxxxx-a.oregon-redis.render.com
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === SHOPIFY APP CONFIGURATION ===
# Note: Individual store Shopify credentials are stored in database during user registration
# These are only needed if you have a global Shopify app configuration
# Leave empty if using per-store credentials (recommended)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_customers,write_customers,read_themes,write_themes

# === FRONTEND & BACKEND URLS (Production) ===
FRONTEND_URL=https://splitset.in
APP_URL=https://api.splitset.in
REDIRECT_URI=https://api.splitset.in/auth/callback

# === SECURITY (Production - Auto-Generated) ===
JWT_SECRET=d7564645039068ad9d37f6fc5f5119389320ffe952aa8388a95931a9e06d4568
ENCRYPTION_KEY=a5df7cae19272feeed6a475c672ec770
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=30
APP_SECRET=00b5742a36821a65f732ac36a383fa9a14783685e2ddac1f766e1329c7f2a3ce
WEBHOOK_SECRET=4863a964483e10571e5e57e671d7be80c84dc679d4fae309347321c084e802fc

# === PERFORMANCE ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
ANALYTICS_REFRESH_MINUTES=30
ENABLE_CLEANUP=true
CLEANUP_INTERVAL_HOURS=24

# === LOGGING ===
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=false
ENABLE_PERFORMANCE_LOGGING=true

# === MONITORING ===
HEALTH_CHECK_TIMEOUT_MS=5000
