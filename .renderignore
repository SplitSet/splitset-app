# Render ignore file - specify what NOT to deploy
# This ensures migration files ARE included

# Ignore development files
frontend/node_modules/
node_modules/
*.log
.env.local
.env.development

# Ignore test files  
**/__tests__/
**/*.test.js
**/*.spec.js
coverage/

# But DO NOT ignore:
# backend/migrations/ - KEEP THESE
# backend/scripts/ - KEEP THESE  
# backend/routes/ - KEEP THESE
